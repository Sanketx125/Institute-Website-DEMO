# ==============================================================================
# DEEKSHAAM PRODUCTION PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=5000
API_BASE_URL=http://localhost:5000/api
CLIENT_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deekshaam_production?schema=public

# Security & Authentication
# REQUIRED in production — the API refuses to start without them. Leave empty in
# development to auto-generate throwaway secrets per boot.
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Bootstrap staff account passwords (REQUIRED in production, no defaults).
# In development a one-time random password is printed to the API console if unset.
ADMIN_PASSWORD=
STAFF_PASSWORD=

# Storage Locations (Paths relative to project root or absolute paths)
PUBLIC_MEDIA_STORAGE=storage/public-media
PRIVATE_DOCUMENTS_STORAGE=storage/private-documents
MAX_FILE_SIZE_MB=10

# Razorpay Payment Gateway
# Key secret and webhook secret are REQUIRED in production (signatures are always verified).
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional AI Assistant
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL_NAME=

# Analytics & Monitoring
ENABLE_AUDIT_LOGGING=true
ENABLE_ANALYTICS=true

# Search & SEO (see docs/SEO.md)
# CLIENT_ORIGIN above doubles as the canonical origin: in production every other host/protocol 301s to it.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# 8-128 hex chars, e.g. node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
INDEXNOW_KEY=
# true = block AI model-training crawlers (GPTBot, Google-Extended, CCBot...); search/AI-answer crawlers stay allowed
BLOCK_AI_TRAINING=false
