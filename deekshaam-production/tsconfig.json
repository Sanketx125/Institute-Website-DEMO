{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@deekshaam/types": ["packages/types/src"],
      "@deekshaam/validation": ["packages/validation/src"],
      "@deekshaam/ui": ["packages/ui/src"]
    }
  }
}
