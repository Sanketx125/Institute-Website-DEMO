# Multi-stage Dockerfile for Deekshaam Production Web Client
FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json tsconfig.json ./
COPY packages/ ./packages/
COPY apps/web/ ./apps/web/

RUN npm install
RUN npm run build:packages
RUN npm run build:web

# Nginx Production Serving
FROM nginx:alpine AS runner

COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# Static files are served directly; every other path (pages, sitemap, robots.txt) goes to
# the API, which server-renders HTML with per-route SEO tags and real 404/301 statuses.
RUN echo 'server { \
    listen 80; \
    server_name localhost; \
    gzip on; \
    gzip_vary on; \
    gzip_min_length 1024; \
    gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml; \
    location /assets/ { \
        root /usr/share/nginx/html; \
        expires 1y; \
        add_header Cache-Control "public, max-age=31536000, immutable"; \
    } \
    location / { \
        root /usr/share/nginx/html; \
        try_files $uri @app; \
    } \
    location @app { \
        proxy_pass http://api:5000; \
        proxy_set_header Host $host; \
        proxy_set_header X-Real-IP $remote_addr; \
    } \
    location /api/ { \
        proxy_pass http://api:5000/api/; \
        proxy_set_header Host $host; \
        proxy_set_header X-Real-IP $remote_addr; \
    } \
    location /public-media/ { \
        proxy_pass http://api:5000/public-media/; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
