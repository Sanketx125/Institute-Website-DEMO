# ==============================================================================
# DEEKSHAAM PRODUCTION PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=5000
API_BASE_URL=http://localhost:5000/api
CLIENT_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deekshaam_production?schema=public

# Security & Authentication
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars-long!
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Storage Locations (Paths relative to project root or absolute paths)
PUBLIC_MEDIA_STORAGE=storage/public-media
PRIVATE_DOCUMENTS_STORAGE=storage/private-documents
MAX_FILE_SIZE_MB=10

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key_change_me
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Optional AI Assistant
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL_NAME=

# Analytics & Monitoring
ENABLE_AUDIT_LOGGING=true
ENABLE_ANALYTICS=true
